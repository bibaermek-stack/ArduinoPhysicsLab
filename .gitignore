# ArduinoPhysicsLab — conservative .gitignore
# Audited before first commit (Phase 1-6 stable baseline). Ignores only
# generated/runtime/machine-specific content. Source code, tests, docs,
# firmware, design assets, migration code, and packaging config
# (build/app.spec, build/build.ps1) are all intentionally tracked.

# --- Python runtime/build artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.so
build/dist/
dist/
*.egg-info/
.eggs/

# --- Virtual environment ---
.venv/
venv/
env/

# --- Test/tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# --- Transient logs and regression run artifacts ---
*.log
debug.log
test_logs/

# --- Secrets / machine-specific configuration ---
.env
.env.*
*.pem
*.key
*credentials*.json
/deployment.json

# --- Local runtime databases (none are checked in as fixtures today —
#     audited before adding this rule) ---
*.db
*.sqlite
*.sqlite3

# --- Editor/IDE ---
.vscode/
.idea/
*.swp

# --- OS artifacts ---
.DS_Store
Thumbs.db

# --- Session-local Claude Code state (not shared project config) ---
.claude/

# --- PyInstaller local build output (build/app.spec and build/build.ps1
#     are source and intentionally tracked; only actual output is ignored) ---
build/*.exe
build/*.dll
build/work/
release/
